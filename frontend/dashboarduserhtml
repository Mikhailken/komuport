<!DOCTYPE html>
<html lang="id">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Dashboard - KomuReport</title>
  <link rel="stylesheet" href="css/style.css">
</head>
<body>

  <!-- ===== HEADER NAVIGASI (dipakai di semua halaman warga) ===== -->
  <header class="header">
    <div class="header-isi">
      <a href="dashboarduser.html" class="brand-nama">Komu<span>Report</span></a>
      <nav class="nav">
        <a href="dashboarduser.html" class="aktif">Dashboard</a>
        <a href="buat-laporan.html">Buat Laporan</a>
        <a href="profil.html">Profil</a>
        <a href="login.html">Logout</a>
      </nav>
    </div>
  </header>

  <main class="container">

    <!-- Judul halaman + filter + tombol -->
    <div class="judul-halaman">
      <div>
        <h1>Dashboard</h1>
        <p class="subjudul">Daftar laporan dari warga</p>
      </div>
      <div class="aksi-halaman">
        <div class="filter">
          <button class="filter-item aktif">Semua</button>
          <button class="filter-item">Belum Selesai</button>
          <button class="filter-item">Selesai</button>
        </div>
        <a href="buat-laporan.html" class="tombol">+ Buat Laporan</a>
      </div>
    </div>

    <!-- Daftar kartu laporan.
         Untuk sekarang isinya CONTOH (statis).
         Nanti diganti otomatis dengan data dari Firestore. -->
    <section class="grid-laporan">

      <article class="kartu">
        <div class="kartu-foto"></div>
        <div class="kartu-isi">
          <p class="kartu-tanggal">1 November 2026</p>
          <h3>Anjing Hilang</h3>
          <p class="kartu-lokasi">Lokasi: Blok A</p>
          <div class="kartu-bawah">
            <span class="badge badge-belum">Belum Selesai</span>
            <a href="detail-laporanuser.html">Lihat Detail →</a>
          </div>
        </div>
      </article>

      <article class="kartu">
        <div class="kartu-foto"></div>
        <div class="kartu-isi">
          <p class="kartu-tanggal">2 November 2026</p>
          <h3>Mobil Parkir Liar</h3>
          <p class="kartu-lokasi">Lokasi: Blok B</p>
          <div class="kartu-bawah">
            <span class="badge badge-belum">Belum Selesai</span>
            <a href="detail-laporanuser.html">Lihat Detail →</a>
          </div>
        </div>
      </article>

      <article class="kartu">
        <div class="kartu-foto"></div>
        <div class="kartu-isi">
          <p class="kartu-tanggal">3 November 2026</p>
          <h3>Kerusakan Jalan</h3>
          <p class="kartu-lokasi">Lokasi: Blok C</p>
          <div class="kartu-bawah">
            <span class="badge badge-belum">Belum Selesai</span>
            <a href="detail-laporanuser.html">Lihat Detail →</a>
          </div>
        </div>
      </article>

      <article class="kartu">
        <div class="kartu-foto"></div>
        <div class="kartu-isi">
          <p class="kartu-tanggal">4 November 2026</p>
          <h3>Lampu Jalan Mati</h3>
          <p class="kartu-lokasi">Lokasi: Blok C</p>
          <div class="kartu-bawah">
            <span class="badge badge-selesai">Selesai</span>
            <a href="detail-laporanuser.html">Lihat Detail →</a>
          </div>
        </div>
      </article>

    </section>
  </main>

</body>
</html>